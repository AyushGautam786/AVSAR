# Backend Environment Variables Example
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to GitHub.

# Supabase project URL
SUPABASE_URL=https://your-project.supabase.co

# Supabase service role key — has full DB access, NEVER expose on the frontend
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Supabase JWT secret — used to verify Bearer tokens from the frontend
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Allowed CORS origin
CORS_ORIGIN=http://localhost:5173

# Apify credentials (used by ingestion script)
APIFY_TOKEN=your-apify-api-token
APIFY_ACTOR_ID=username~internshala-scraper

# Adzuna API credentials
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_APP_KEY=your-adzuna-app-key

# LLM credentials (Resume Tailoring)
# Free options: gemini (Google AI Studio) or groq (Groq Cloud)
# Paid options: anthropic, openai
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key       # Get 100% free at https://aistudio.google.com/
# GROQ_API_KEY=your-groq-api-key         # Get 100% free at https://console.groq.com/keys
# ANTHROPIC_API_KEY=your-anthropic-api-key
# OPENAI_API_KEY=your-openai-api-key

# Supabase Storage bucket for resumes
SUPABASE_STORAGE_BUCKET_RESUMES=resumes
