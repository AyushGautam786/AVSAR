# Frontend Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env (it is gitignored).

# Supabase project URL (from Supabase dashboard → Project Settings → API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key (safe for the frontend — enforced by RLS)
VITE_SUPABASE_KEY=your-anon-public-key-here

# Deployed Flask API URL (Render web service URL in production, localhost for local dev)
VITE_API_URL=http://localhost:5000
